{
  "name": "claude-pr-review",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted GitHub PR reviewer built on the Claude Agent SDK",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "review": "node dist/cli.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
