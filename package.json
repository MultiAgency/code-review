{
  "name": "multi-review",
  "version": "0.1.0",
  "private": true,
  "description": "Multi Review: a self-hosted GitHub PR reviewer",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "review": "node dist/cli.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx --test test/live/*.live.ts",
    "typecheck": "tsc -p tsconfig.test.json",
    "backtest": "node dist/backtest.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
